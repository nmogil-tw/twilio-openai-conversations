# Essential Configuration - Add your credentials here

# Twilio Configuration (from console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_CONVERSATIONS_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI Configuration (from platform.openai.com)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Settings (defaults work for most cases)
# OPENAI_MODEL=gpt-4o-mini
# DEBUG=true

# Voice Configuration (for voice call support)
# Required for voice calls - your ngrok domain without https://
NGROK_DOMAIN=your-ngrok-domain.ngrok.app


# Security Settings
# Set to false for development if having signature issues
VALIDATE_WEBHOOK_SIGNATURES=true
WEBHOOK_SECRET=your_webhook_secret_here